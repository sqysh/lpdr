generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────
enum AuctionStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum BidderStatus {
  REGISTERED
  ACTIVE
  DISQUALIFIED
  LOST
  WINNER
}

enum BidStatus {
  TOP_BID
  OUTBID
}

enum SellingFormat {
  AUCTION
  FIXED
}

enum AuctionItemStatus {
  UNSOLD
  ACTIVE
  SOLD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum WinningBidPaymentStatus {
  AWAITING_PAYMENT
  PAID
  FAILED
  REFUNDED
}

enum ShippingStatus {
  PENDING_FULFILLMENT
  PENDING_PAYMENT_CONFIRMATION
  SHIPPED
  DELIVERED
  DIGITAL
}

enum AddressType {
  SHIPPING
  BILLING
}

enum Role {
  SUPER_USER
  ADMIN
  PACK_MEMBER
}

enum OrderType {
  ONE_TIME_DONATION
  RECURRING_DONATION
  ADOPTION_FEE
  AUCTION_PURCHASE
  PURCHASE
  ECARD
  ADOPTION_AGREEMENT
}

enum OrderItemType {
  PRODUCT
  WELCOME_WIENER
  FEED_A_FOSTER
  AUCTION_WINNING_BID
  AUCTION_INSTANT_BUY
}

enum OrderStatus {
  PENDING // Cart/checkout in progress
  PROCESSING // Payment being processed
  CONFIRMED // Payment successful
  CANCELLED // Order cancelled
  REFUNDED // Order refunded
  FAILED // Payment failed
}

enum RecurringFrequency {
  MONTHLY
  YEARLY
}

enum AdoptionFeeStatus {
  ACTIVE
  EXPIRED
  APPROVED
  REJECTED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum AdoptionAgreementStatus {
  DRAFT
  SENT
  SIGNED
  PAID
  COMPLETE
  VOID // cancelled before payment
  RETURNED // adopted, then the dog came back
}

enum AdoptionPaymentMethod {
  CARD
  ZELLE
  VENMO
  PAYPAL
}

// The adopter signs twice: once agreeing to the terms, then again on the financial page,
// where a second adopter can also sign. The representative countersigns last
enum AgreementSignatureRole {
  TERMS_ADOPTER
  FINANCIAL_FIRST_ADOPTER
  FINANCIAL_SECOND_ADOPTER
  REPRESENTATIVE
}

// ─── Next Auth ────────────────────────────────────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Address ───────────────────────────────────────────────────
model Address {
  id String @id @default(cuid())

  name          String
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  zipPostalCode String
  country       String  @default("US")

  isDefault Boolean     @default(false)
  type      AddressType @default(SHIPPING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, isDefault])
}

// ─── User ────────────────────────────────────────────────────────────────────
model User {
  id    String @id @default(cuid())
  email String @unique

  // Profile
  name      String?
  firstName String?
  lastName  String?
  phone     String?
  image     String?

  // Account
  role           Role       @default(PACK_MEMBER)
  status         UserStatus @default(ACTIVE)
  emailVerified  DateTime?
  lastLoginAt    DateTime?
  hasSeenWelcome Boolean    @default(false)
  metadata       Json?

  // Auction preferences
  anonymousBidding Boolean @default(false)
  autoPay          Boolean @default(false)
  autoPayCoverFees Boolean @default(false)

  // Payments
  stripeCustomerId String?

  // Last known location, stamped on sign-in
  lastGeoLatitude  Float?
  lastGeoLongitude Float?
  lastGeoCity      String?
  lastGeoRegion    String?
  lastGeoCountry   String?

  // Migration from the old site
  hasMigrated Boolean   @default(false)
  migratedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Auth
  accounts          Account[]
  sessions          Session[]
  emailChangeTokens EmailChangeToken[]

  // Profile and payments
  address        Address?
  paymentMethods PaymentMethod[]
  orders         Order[]

  // Auctions
  bidder      AuctionBidder[]
  bids        AuctionBid[]
  winningBids AuctionWinningBidder[]
  instantBuys AuctionItemInstantBuyer[]

  // Adoptions
  adoptionFees         AdoptionFee[]
  adoptionAgreements   AdoptionAgreement[]
  agreementsCreated    AdoptionAgreement[] @relation("AgreementCreatedBy")
  agreementsMarkedPaid AdoptionAgreement[] @relation("AgreementMarkedPaidBy")
  agreementsClosed     AdoptionAgreement[] @relation("AgreementClosedBy")
}

// ─── Payment Method ────────────────────────────────────────────────────────────────────
model PaymentMethod {
  id              String @id @default(cuid())
  stripePaymentId String @unique // stripe_pm_xxxxx

  cardholderName String?
  cardBrand      String // visa, mastercard, etc
  cardLast4      String // 4242
  cardExpMonth   Int
  cardExpYear    Int

  isDefault Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fingerprint String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, fingerprint])
  @@index([userId])
}

// ─── Order ────────────────────────────────────────────────────────────────────
model Order {
  id        String      @id @default(cuid())
  type      OrderType
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  source    String      @default("SITE") // 'SITE' | 'MONGO_MIGRATION'

  // ── Payment ─────────────────────────────────────────────
  subtotal           Decimal   @default(0) @db.Decimal(10, 2) // items, or fees for orders without items
  shipping           Decimal   @default(0) @db.Decimal(10, 2)
  totalAmount        Decimal   @db.Decimal(10, 2) // subtotal + shipping + feesCovered
  paymentIntentId    String?   @unique // Stripe payment intent ID
  paymentMethodId    String? // Stripe payment method ID used
  paidAt             DateTime? // When payment was completed
  coverFees          Boolean   @default(false)
  autoPaid           Boolean   @default(false)
  feesCovered        Decimal   @default(0) @db.Decimal(10, 2)
  failureReason      String?
  failureCode        String?
  failureEmailSentAt DateTime?
  refundEmailSentAt  DateTime?
  stripeInvoiceId    String?   @unique

  // ── Customer (denormalized snapshot) ────────────────────
  customerEmail String
  customerName  String
  customerPhone String?
  userId        String?
  user          User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // ── Recurring donations ─────────────────────────────────
  isRecurring          Boolean             @default(false)
  recurringFrequency   RecurringFrequency?
  stripeSubscriptionId String?
  nextBillingDate      DateTime? // Next charge date
  tierName             String?
  isFirstPayment       Boolean             @default(false)

  // ── Shipping (address snapshot at purchase) ─────────────
  isPhysical     Boolean         @default(false)
  shippingStatus ShippingStatus?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  zipPostalCode  String?
  country        String?

  // ── Geolocation (IP-derived at checkout; geocode upgrade for shipped orders) ──
  geoLatitude  Float?
  geoLongitude Float?
  geoCity      String?
  geoRegion    String? // state/province code
  geoCountry   String?
  geoPlaceId   String? // Google Place ID when geocoded
  geoSource    String? // 'ip' | 'geocode'

  // ── Relations / misc ────────────────────────────────────
  items OrderItem[]
  notes String?

  adoptionFee       AdoptionFee?
  adoptionAgreement AdoptionAgreement?

  // ── Donor message (e.g. in memory of someone) ───────────
  donorMessage String?

  // Set for payments received outside Stripe and recorded by hand, like Zelle, Venmo or PayPal for an adoption
  offlinePaymentMethod AdoptionPaymentMethod?

  // Cumulative, as Stripe reports it. The order only moves to REFUNDED when the whole charge is returned
  refundedAmount Decimal?  @db.Decimal(10, 2)
  refundedAt     DateTime?

  @@index([type, createdAt])
  @@index([status])
  @@index([userId])
  @@index([customerEmail])
  @@index([createdAt])
  @@index([stripeSubscriptionId])
}

// ─── Order Item ─────────────────────────────────────────────────────────────────
model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  price         Decimal  @db.Decimal(10, 2)
  quantity      Int?
  subtotal      Decimal? @db.Decimal(10, 2)
  totalPrice    Decimal? @db.Decimal(10, 2)
  isPhysical    Boolean  @default(false)
  shippingPrice Decimal  @default(0) @db.Decimal(10, 2)

  // Shared snapshot fields
  itemName  String?
  itemImage String?
  images    String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  welcomeWienerId String?
  welcomeWiener   WelcomeWiener? @relation(fields: [welcomeWienerId], references: [id], onDelete: SetNull)

  size      String?
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  iconKey  String?
  itemType OrderItemType?
}

// ─── Auction ─────────────────────────────────────────────────────────────────
model Auction {
  id                  String        @id @default(cuid())
  title               String
  status              AuctionStatus @default(DRAFT)
  goal                Decimal       @default(1000) @db.Decimal(10, 2)
  totalAuctionRevenue Decimal       @default(0) @db.Decimal(10, 2)
  supporters          Int           @default(0)
  supporterEmails     String[]
  customAuctionLink   String?       @unique
  startDate           DateTime
  endDate             DateTime
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  source String @default("SITE") // 'SITE' | 'MONGO_MIGRATION'

  mongoId String? @unique

  historicalItemCount   Int @default(0)
  historicalBidderCount Int @default(0)
  historicalBidCount    Int @default(0)

  isPubliclyVisible Boolean @default(false)

  winnersResolvedAt DateTime?

  items          AuctionItem[]
  bidders        AuctionBidder[]
  bids           AuctionBid[]
  instantBuyers  AuctionItemInstantBuyer[]
  winningBidders AuctionWinningBidder[]
  anomalies      AuctionAnomaly[]

  @@index([status, endDate, winnersResolvedAt])
}

// ─── Auction Item ─────────────────────────────────────────────────────────────
model AuctionItem {
  id               String            @id @default(cuid())
  auctionId        String
  auction          Auction           @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  sellingFormat    SellingFormat
  startingPrice    Decimal?          @db.Decimal(10, 2)
  buyNowPrice      Decimal?          @db.Decimal(10, 2)
  currentPrice     Decimal?          @db.Decimal(10, 2)
  currentBid       Decimal?          @db.Decimal(10, 2)
  minimumBid       Decimal?          @db.Decimal(10, 2)
  soldPrice        Decimal?          @db.Decimal(10, 2)
  retailValue      String?
  totalQuantity    Int?
  totalBids        Int               @default(0)
  requiresShipping Boolean           @default(true)
  shippingCosts    Decimal?          @db.Decimal(10, 2)
  status           AuctionItemStatus @default(UNSOLD)
  topBidder        String?
  itemBtnText      String?
  isAuction        Boolean           @default(false)
  isFixed          Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  photos        AuctionItemPhoto[]
  bids          AuctionBid[]
  instantBuyers AuctionItemInstantBuyer[]

  auctionWinningBidderId String?
  winningBidder          AuctionWinningBidder? @relation(fields: [auctionWinningBidderId], references: [id])

  @@index([auctionId])
}

// ─── Auction Bidder ───────────────────────────────────────────────────────────
model AuctionBidder {
  id        String       @id @default(cuid())
  auctionId String
  auction   Auction      @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    BidderStatus @default(REGISTERED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  bids AuctionBid[]

  @@unique([auctionId, userId]) // prevent duplicate registrations
  @@index([auctionId])
  @@index([userId])
}

// ─── Auction Bid ──────────────────────────────────────────────────────────────
model AuctionBid {
  id              String        @id @default(cuid())
  auctionId       String
  auction         Auction       @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  auctionItemId   String
  auctionItem     AuctionItem   @relation(fields: [auctionItemId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  bidderId        String
  bidder          AuctionBidder @relation(fields: [bidderId], references: [id])
  bidAmount       Decimal       @db.Decimal(10, 2)
  bidderName      String? // for anonymous display
  email           String?
  status          BidStatus     @default(TOP_BID)
  sentWinnerEmail Boolean       @default(false)
  emailCount      Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([auctionId])
  @@index([auctionItemId])
  @@index([userId])
}

// ─── Auction Item Instant Buyer ───────────────────────────────────────────────
model AuctionItemInstantBuyer {
  id             String         @id @default(cuid())
  auctionId      String
  auction        Auction        @relation(fields: [auctionId], references: [id])
  auctionItemId  String
  auctionItem    AuctionItem    @relation(fields: [auctionItemId], references: [id])
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  name           String?
  email          String?
  totalPrice     Decimal?       @db.Decimal(10, 2)
  paymentStatus  PaymentStatus  @default(PAID)
  shippingStatus ShippingStatus @default(PENDING_FULFILLMENT)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([auctionId])
  @@index([auctionItemId])
}

// ─── Auction Winning Bidder ───────────────────────────────────────────────────
model AuctionWinningBidder {
  id                                         String                  @id @default(cuid())
  auctionId                                  String
  auction                                    Auction                 @relation(fields: [auctionId], references: [id])
  userId                                     String
  user                                       User                    @relation(fields: [userId], references: [id])
  winningBidPaymentStatus                    WinningBidPaymentStatus @default(AWAITING_PAYMENT)
  auctionItemPaymentStatus                   PaymentStatus           @default(PENDING)
  auctionPaymentNotificationEmailHasBeenSent Boolean                 @default(false)
  emailNotificationCount                     Int                     @default(0)
  elapsedTimeSinceAuctionItemWon             String?
  processingFee                              Decimal?                @db.Decimal(10, 2)
  totalPrice                                 Decimal?                @db.Decimal(10, 2)
  itemsTotal                                 Decimal?                @db.Decimal(10, 2)
  itemSoldPrice                              Decimal?                @db.Decimal(10, 2)
  shipping                                   Decimal?                @db.Decimal(10, 2)
  shippingStatus                             ShippingStatus          @default(PENDING_PAYMENT_CONFIRMATION)
  shippingProvider                           String?
  trackingNumber                             String?
  paidOn                                     DateTime?
  createdAt                                  DateTime                @default(now())
  updatedAt                                  DateTime                @updatedAt

  auctionItems AuctionItem[]

  paymentIntentId String?

  autoPayAttemptedAt DateTime?
  autoPayError       String?

  @@index([auctionId])
  @@index([userId])
}

// ─── Auction Item Photo ───────────────────────────────────────────────────────
model AuctionItemPhoto {
  id        String      @id @default(cuid())
  itemId    String
  item      AuctionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  url       String
  name      String?
  size      String?
  isPrimary Boolean     @default(false)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([itemId])
}

// ─── Adoption Application Bypass Code ───────────────────────────────────────────────────
model AdoptionApplicationBypassCode {
  id             String   @id @default(cuid())
  bypassCode     String   @unique
  nextRotationAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Product ────────────────────────────────────────────────────
model Product {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Details
  name        String?
  description String?
  images      String[]

  // Pricing & inventory
  price         Decimal @default(0) @db.Decimal(10, 2)
  shippingPrice Decimal @default(0) @db.Decimal(10, 2)
  countInStock  Int     @default(0)
  sizes         Json? // [{ size: "S", quantity: 10 }, { size: "M", quantity: 5 }]

  // Status
  isPhysicalProduct Boolean   @default(true)
  isLive            Boolean   @default(false)
  archivedAt        DateTime? // set = retired; isLive flips false alongside

  // Relations
  orderItems OrderItem[]
}

// ─── WelcomeWiener ──────────────────────────────────────────────
model WelcomeWiener {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Details
  name   String?
  bio    String?
  age    String?
  images String[]

  // Donation options
  associatedProducts Json[] // WelcomeWienerProduct[]: { id, name, description, price, category, image? }

  // Status
  isPhysicalProduct Boolean   @default(false)
  isLive            Boolean   @default(false)
  archivedAt        DateTime?

  // Relations
  orderItems OrderItem[]
}

// ─── Newsletter ───────────────────────────────────────────────────
model Newsletter {
  id              String   @id @default(cuid())
  newsletterEmail String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── AdoptionFee ───────────────────────────────────────────────────
model AdoptionFee {
  id         String            @id @default(cuid())
  firstName  String?
  lastName   String?
  email      String?
  state      String?
  feeAmount  Decimal?          @default(15) @db.Decimal(10, 2)
  bypassCode String?
  expiresAt  DateTime?
  status     AdoptionFeeStatus @default(ACTIVE)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

// ─── Log ───────────────────────────────────────────────────
model Log {
  id        String   @id @default(cuid())
  level     String
  message   String
  metadata  Json?
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── NewsletterIssue ───────────────────────────────────────────────────
model NewsletterIssue {
  id        String   @id @default(cuid())
  month     String
  year      String
  pdfUrl    String
  isLive    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdoptionAgreement {
  id     String                  @id @default(cuid())
  status AdoptionAgreementStatus @default(DRAFT)

  // Admin picks the adopter's existing account; the page only opens for that user
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Dog, snapshotted: the listing changes and is removed once the dog is adopted
  dogRescueGroupsId String
  dogName           String
  dogRescueId       String
  dogSex            String
  dogAge            String
  dogColorMarkings  String?
  dogPhoto          String?
  dogSnapshot       Json

  microchipNumber       String?
  microchipManufacturer String?
  microchipRegistration String?

  // Medical, entered by admin from the foster's records
  rabiesDate              DateTime?
  rabiesDuration          String?
  bordetellaDate          DateTime?
  bordetellaDuration      String?
  distemperDate           DateTime?
  spayNeuterDate          DateTime?
  // Free text on the form ("Date & Results"), so kept as one field rather than split
  heartwormTest           String?
  fecalTest               String?
  heartwormPreventionDate DateTime?
  fleaTickPreventionDate  DateTime?
  knownIssues             String?

  // Adopter details as signed, prefilled from their account. Kept on the agreement because it is a
  // legal record: it should still say what they signed even if they later change their email or move
  firstName     String?
  lastName      String?
  email         String
  phone         String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  zipPostalCode String?

  // Parsed from adoptionFeeString and not editable here: the fee is set in RescueGroups, and this is
  // the snapshot of what the adopter agreed to. Subtotal and total are derived, not stored
  adoptionFee          Decimal  @db.Decimal(10, 2)
  // Varies by dog: what the vet actually charged for the certificate
  healthCertificateFee Decimal? @db.Decimal(10, 2)
  additionalDonation   Decimal? @db.Decimal(10, 2)

  // Chosen by admin. Anything but CARD skips the payment step and emails instructions instead
  paymentMethod  AdoptionPaymentMethod @default(CARD)
  orderId        String?               @unique
  order          Order?                @relation(fields: [orderId], references: [id])
  paidAt         DateTime?
  // Set when someone records a Zelle, Venmo or PayPal payment by hand
  markedPaidById String?
  markedPaidBy   User?                 @relation("AgreementMarkedPaidBy", fields: [markedPaidById], references: [id])

  // Which terms were agreed to: the clauses will be revised, and a signed agreement must keep its own
  termsVersion String

  signatures AdoptionAgreementSignature[]

  // Set when the agreement email fails to send, cleared when a send succeeds. The admin detail page
  // shows these with a resend button
  emailFailedAt      DateTime?
  emailFailureReason String?

  // The admin who prepares the agreement is also the LPDR representative who countersigns it
  createdById String
  createdBy   User      @relation("AgreementCreatedBy", fields: [createdById], references: [id])
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Who ended the agreement and why, for both VOID and RETURNED. The status says which
  closedAt     DateTime?
  closedReason String?
  closedById   String?
  closedBy     User?     @relation("AgreementClosedBy", fields: [closedById], references: [id])

  @@index([status, createdAt])
  @@index([userId])
  @@index([dogRescueGroupsId])
}

model AdoptionAgreementSignature {
  id          String                 @id @default(cuid())
  agreementId String
  agreement   AdoptionAgreement      @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  role        AgreementSignatureRole

  typedName String

  // What makes a typed signature hold up: who, when, and from where
  signedAt  DateTime @default(now())
  ipAddress String?
  userAgent String?

  @@unique([agreementId, role])
}

// ─── AuctionAnomaly ───────────────────────────────────────────────────
model AuctionAnomaly {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  type      String
  itemId    String
  itemName  String
  message   String
  metadata  Json?
  dismissed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([auctionId])
}

model EmailChangeToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PendingAdminInvite {
  id        String   @id @default(cuid())
  email     String   @unique
  role      Role
  createdAt DateTime @default(now())
  createdBy String
}

model PaymentAttempt {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model SignInAttempt {
  id         String   @id @default(cuid())
  identifier String
  createdAt  DateTime @default(now())

  @@index([identifier])
  @@index([createdAt])
}

// ─── STAGING TABLES ───────────────────────────────────────────────────
model MongoUser {
  id        String   @id @default(cuid())
  mongoId   String   @unique // Mongo _id as string
  email     String   @unique
  data      Json // raw Mongo document
  migrated  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model MongoDonation {
  id        String   @id @default(cuid())
  mongoId   String   @unique
  email     String
  data      Json
  migrated  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model MongoOrder {
  id        String   @id @default(cuid())
  mongoId   String   @unique
  email     String
  data      Json
  migrated  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model MongoOrderItem {
  id           String   @id @default(cuid())
  mongoId      String   @unique
  mongoOrderId String // references MongoOrder.mongoId
  data         Json
  createdAt    DateTime @default(now())

  @@index([mongoOrderId])
}

